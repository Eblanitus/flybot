{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "deny",
      "*/brain/learned/*": "allow",
      "brain/learned/*": "allow",
      "*/brain/notes.md": "allow",
      "brain/notes.md": "allow",
      "*/brain/core_bugs.md": "allow",
      "brain/core_bugs.md": "allow",
      "*/brain/ready.flag": "allow",
      "brain/ready.flag": "allow",
      "*/brain/skill_requests/*": "allow",
      "brain/skill_requests/*": "allow",
      "*/brain/blueprints/*": "allow",
      "brain/blueprints/*": "allow",
      "*/behavior/*": "allow",
      "behavior/*": "allow"
