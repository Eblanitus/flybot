    "bash": {
      "*": "deny",
      "curl *": "allow",
      "curl.exe *": "allow",
      "node test/behavior.js": "allow",
      "node test/offline.js": "allow"
    },
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "task": "deny"
  },
  "mcp": {
    "Roblox_Studio": {
      "type": "local",
      "command": [
        "cmd.exe"
      ],
      "enabled": false
    },
    "Blender_MCP_9876": {
      "type": "local",
      "command": [
        "uvx"
      ],
      "enabled": false
    },
    "Blender_MCP_9784": {
      "type": "local",
      "command": [
        "uvx"
      ],
      "enabled": false
    }
  }
